<nav class="navbar navbar-expand-lg navbar-dark navbar-peak">
  <div class="container flex-column align-items-stretch">
    <div class="navbar-heading">
      <%= link_to "Prairie Peak Outfitters", root_path, class: "navbar-brand" %>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
              aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
      </button>
    </div>
    <div class="collapse navbar-collapse" id="mainNav">
      <div class="navbar-content">
        <ul class="navbar-nav navbar-primary-nav">
          <li class="nav-item"><%= link_to "All products", products_path, class: "nav-link" %></li>
          <li class="nav-item dropdown">
            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Categories</a>
            <ul class="dropdown-menu">
              <% nav_categories.each do |category| %>
                <li><%= link_to category.name, category_path(category), class: "dropdown-item" %></li>
              <% end %>
            </ul>
          </li>
          <li class="nav-item"><%= link_to "On sale", products_path(filter: "on_sale"), class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "About", about_path, class: "nav-link" %></li>
          <li class="nav-item"><%= link_to "Contact", contact_path, class: "nav-link" %></li>
        </ul>

        <%= form_with url: products_path, method: :get, class: "navbar-search", role: "search" do |f| %>
          <%= f.search_field :q, value: params[:q], class: "form-control form-control-sm", placeholder: "Search gear", "aria-label": "Search" %>
          <%= f.select :category_id, options_from_collection_for_select(nav_categories, :id, :name, params[:category_id]),
                       { include_blank: "All categories" }, class: "form-select form-select-sm", "aria-label": "Category" %>
          <%= f.submit "Search", name: nil, class: "btn btn-sm btn-warning" %>
        <% end %>

        <ul class="navbar-nav navbar-account-nav">
          <li class="nav-item"><%= link_to "Cart (#{current_cart.count})", cart_path, class: "nav-link" %></li>
          <% if user_signed_in? %>
            <li class="nav-item"><%= link_to "My orders", orders_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "My address", edit_account_path, class: "nav-link" %></li>
            <li class="nav-item"><%= button_to "Log out (#{current_user.username})", destroy_user_session_path, method: :delete, class: "btn btn-link nav-link" %></li>
          <% else %>
            <li class="nav-item"><%= link_to "Log in", new_user_session_path, class: "nav-link" %></li>
            <li class="nav-item"><%= link_to "Sign up", new_user_registration_path, class: "nav-link" %></li>
          <% end %>
        </ul>
      </div>
    </div>
  </div>
</nav>
