<%= form_with model: user, url: account_path, method: :patch do |f| %>
  <% if user.errors.any? %>
    <div class="alert alert-danger"><ul class="mb-0"><% user.errors.full_messages.each do |m| %><li><%= m %></li><% end %></ul></div>
  <% end %>
  <div class="row g-3">
    <div class="col-md-6"><%= f.label :first_name, class: "form-label" %><%= f.text_field :first_name, class: "form-control" %></div>
    <div class="col-md-6"><%= f.label :last_name, class: "form-label" %><%= f.text_field :last_name, class: "form-control" %></div>
    <div class="col-12"><%= f.label :phone, class: "form-label" %><%= f.telephone_field :phone, class: "form-control" %></div>
    <div class="col-12"><%= f.label :address_line1, "Address", class: "form-label" %><%= f.text_field :address_line1, class: "form-control" %></div>
    <div class="col-12"><%= f.label :address_line2, "Apartment, suite, etc.", class: "form-label" %><%= f.text_field :address_line2, class: "form-control" %></div>
    <div class="col-md-5"><%= f.label :city, class: "form-label" %><%= f.text_field :city, class: "form-control" %></div>
    <div class="col-md-4"><%= f.label :province_id, "Province", class: "form-label" %>
      <%= f.collection_select :province_id, Province.order(:name), :id, :name, { include_blank: "Select..." }, class: "form-select" %></div>
    <div class="col-md-3"><%= f.label :postal_code, class: "form-label" %><%= f.text_field :postal_code, class: "form-control", placeholder: "R3C 0A5" %></div>
  </div>
  <%= f.submit submit, class: "btn btn-primary mt-3" %>
<% end %>
