<div class="card product-card">
  <%= link_to product_path(product) do %>
    <%= product_image(product, :thumb, class: "card-img-top") %>
  <% end %>
  <div class="card-body d-flex flex-column">
    <h2 class="h6 card-title"><%= link_to product.name, product_path(product) %></h2>
    <p class="mb-2">
      <% if product.on_sale? %>
        <span class="price-old"><%= money(product.price) %></span>
        <span class="price-sale"><%= money(product.sale_price) %></span>
        <span class="badge text-bg-warning">Sale</span>
      <% else %>
        <strong><%= money(product.price) %></strong>
      <% end %>
    </p>
    <% if product.in_stock? %>
      <%= button_to "Add to cart", cart_items_path(product_id: product.id), method: :post, class: "btn btn-primary btn-sm mt-auto" %>
    <% else %>
      <span class="text-muted mt-auto">Out of stock</span>
    <% end %>
  </div>
</div>
