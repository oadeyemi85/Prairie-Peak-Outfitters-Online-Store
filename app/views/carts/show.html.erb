<% content_for :title, "Your cart" %>
<h1 class="h3">Your cart</h1>
<% if @lines.empty? %>
  <p class="panel">Your cart is empty. <%= link_to "Browse products", products_path %>.</p>
<% else %>
  <div class="panel table-responsive">
    <table class="table align-middle">
      <thead><tr><th>Product</th><th>Price</th><th>Quantity</th><th>Total</th><th></th></tr></thead>
      <tbody>
        <% @lines.each do |product, quantity| %>
          <tr>
            <td><%= link_to product.name, product_path(product) %></td>
            <td><%= money(product.current_price) %></td>
            <td>
              <%= form_with url: cart_item_path(product), method: :patch, class: "d-flex gap-1" do |f| %>
                <%= f.number_field :quantity, value: quantity, min: 1, max: product.stock_quantity, class: "form-control form-control-sm", style: "width:5rem", "aria-label": "Quantity for #{product.name}" %>
                <%= f.submit "Update", class: "btn btn-sm btn-outline-primary" %>
              <% end %>
            </td>
            <td><%= money(product.current_price * quantity) %></td>
            <td><%= button_to "Remove", cart_item_path(product), method: :delete, class: "btn btn-sm btn-outline-danger" %></td>
          </tr>
        <% end %>
      </tbody>
      <tfoot><tr><th colspan="3" class="text-end">Subtotal</th><th colspan="2"><%= money(current_cart.subtotal) %></th></tr></tfoot>
    </table>
    <p class="text-muted">Taxes are calculated at checkout based on your province.</p>
    <%= link_to "Proceed to checkout", new_checkout_path, class: "btn btn-primary" %>
  </div>
<% end %>
