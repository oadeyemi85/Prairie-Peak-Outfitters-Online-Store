<% content_for :title, "Products" %>
<h1 class="h3">Products</h1>
<div class="mb-3 d-flex flex-wrap gap-2">
  <%= link_to "All", products_path(q: params[:q], category_id: params[:category_id]), class: "btn btn-sm #{params[:filter].blank? ? 'btn-primary' : 'btn-outline-primary'}" %>
  <% { "on_sale" => "On sale", "new" => "New", "updated" => "Recently updated" }.each do |key, label| %>
    <%= link_to label, products_path(filter: key, q: params[:q], category_id: params[:category_id]),
                class: "btn btn-sm #{params[:filter] == key ? 'btn-primary' : 'btn-outline-primary'}" %>
  <% end %>
</div>
<% if params[:q].present? %><p class="text-muted">Results for &ldquo;<%= params[:q] %>&rdquo;</p><% end %>
<%= render "shared/product_grid", products: @products %>
<div class="mt-4"><%= paginate @products %></div>
