<% content_for :title, @product.name %>
<div class="row g-4">
  <div class="col-md-5"><%= product_image(@product, :large, class: "product-detail-img") %></div>
  <div class="col-md-7 panel">
    <h1 class="h3"><%= @product.name %></h1>
    <p class="text-muted mb-1">SKU <%= @product.sku %></p>
    <p class="fs-4">
      <% if @product.on_sale? %>
        <span class="text-decoration-line-through text-muted"><%= money(@product.price) %></span>
        <strong class="text-warning"><%= money(@product.sale_price) %></strong>
      <% else %>
        <strong><%= money(@product.price) %></strong>
      <% end %>
    </p>
    <p><%= @product.description %></p>
    <p>
      <% @product.categories.each do |category| %>
        <%= link_to category.name, category_path(category), class: "badge text-bg-secondary text-decoration-none" %>
      <% end %>
    </p>
    <% if @product.in_stock? %>
      <p><%= @product.stock_quantity %> in stock</p>
      <%= form_with url: cart_items_path, method: :post, class: "row g-2 align-items-center" do |f| %>
        <%= f.hidden_field :product_id, value: @product.id %>
        <div class="col-auto"><%= f.number_field :quantity, value: 1, min: 1, max: @product.stock_quantity, class: "form-control", "aria-label": "Quantity" %></div>
        <div class="col-auto"><%= f.submit "Add to cart", class: "btn btn-primary" %></div>
      <% end %>
    <% else %>
      <p class="text-danger">Out of stock</p>
    <% end %>
  </div>
</div>

<% if @related.any? %>
  <h2 class="h4 mt-4">You might also like</h2>
  <%= render "shared/product_grid", products: @related %>
<% end %>
