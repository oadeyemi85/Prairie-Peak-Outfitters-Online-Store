<% content_for :title, "My orders" %>
<h1 class="h3">My orders</h1>
<% if @orders.empty? %>
  <p class="panel">You have not placed any orders yet.</p>
<% end %>
<% @orders.each do |order| %>
  <div class="panel mb-3">
    <h2 class="h5">Order #<%= order.id %> <span class="badge text-bg-secondary"><%= order.status.titleize %></span></h2>
    <p class="text-muted"><%= l(order.created_at, format: :long) %></p>
    <%= render "shared/invoice", order: order %>
  </div>
<% end %>
